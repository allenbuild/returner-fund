{
  "name": "yc-network-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/validate-graph-function-trace.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "topics:backfill:dry-run": "node --experimental-strip-types scripts/reclassify-post-topics.mjs --dry-run",
    "topics:review-set": "node --experimental-strip-types scripts/build-post-topic-review-set.mjs --count=300",
    "topics:evaluate": "node --experimental-strip-types scripts/evaluate-post-topic-review-set.mjs --input=work/post-topic-review-set.json",
    "test:benchmarks:daily": "vitest run tests/update-daily-benchmarks.test.mjs",
    "test:scoring:audit:v4": "node --test tests/scoring-diagnostics-v4.node-test.mjs",
    "test:scoring:experiments:v4": "node scripts/ops/check-scoring-v4-experiment-parity.mjs",
    "test:release:ops": "node --test tests/ops/scoring-v4-release-ops.node-test.mjs",
    "test:cohort-coverage": "node --test tests/cohort-coverage-audit.node-test.mjs && node scripts/audit-cohort-coverage.mjs --compact",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:release": "npm run check && npm run scoring:research:validate && npm run scoring:v5:validate && npm run scoring:v5:audit && npm run test:release:ops && npm run test:scoring:experiments:v4 && npm run test:scoring:audit:v4 && npm run test:cohort-coverage && npm run test:artifacts && npm run artifacts:validate && npm run artifacts:manifest:validate",
    "release:migrate:v4": "node scripts/ops/apply-scoring-v4-migrations.mjs",
    "release:publish:v4": "node scripts/ops/publish-scoring-v4-artifacts.mjs",
    "release:rollback:v4": "node scripts/ops/prepare-scoring-v4-rollback.mjs",
    "debug:evidence": "node scripts/debug-evidence-report.mjs",
    "debug:scoring": "node scripts/debug-scoring-report.mjs",
    "debug:coverage": "node scripts/debug-coverage-report.mjs",
    "debug:workers": "node scripts/debug-workers-report.mjs",
    "debug:duplicates": "node scripts/debug-duplicates-report.mjs",
    "debug:attribution": "node scripts/audit-evidence-attribution.mjs --write-doc",
    "debug:quality": "node scripts/run-quality-audit.mjs",
    "debug:quality:strict": "node scripts/run-quality-audit.mjs --strict",
    "debug:anomalies": "node scripts/run-anomaly-report.mjs",
    "debug:instagram-coverage": "node scripts/debug-instagram-coverage.mjs",
    "debug:thumbnails": "node scripts/debug-thumbnails.mjs",
    "artifacts:validate": "node scripts/validate-public-artifacts.mjs",
    "artifacts:manifest:validate": "node scripts/write-artifact-manifest.mjs --validate",
    "test:artifacts": "node --test tests/validate-public-artifacts.node-test.mjs && vitest run tests/validate-public-artifacts-real-data.test.mjs",
    "benchmarks:daily": "node scripts/update-daily-benchmarks.mjs",
    "thumbnails:backfill": "node scripts/backfill-evidence-thumbnails.mjs",
    "thumbnails:instagram": "node scripts/backfill-evidence-thumbnails.mjs --platform=instagram --cache-instagram --force",
    "thumbnails:x": "node scripts/backfill-evidence-thumbnails.mjs --platform=x --cache-x --validate-x --force",
    "thumbnails:links": "node scripts/backfill-evidence-thumbnails.mjs --fetch-link-preview --missing-only",
    "x:validate": "node scripts/backfill-evidence-thumbnails.mjs --platform=x --validate-x",
    "x:thumbnails": "node scripts/backfill-evidence-thumbnails.mjs --platform=x --validate-x --missing-only",
    "x:thumbnails:batch": "node scripts/backfill-evidence-thumbnails.mjs --platform=x --validate-x --missing-only --max-rows=100",
    "ingest:public": "node scripts/run-public-ingest.mjs",
    "ingest:autonomous": "node scripts/run-autonomous-ingestion.mjs",
    "ingest:top-voices": "node --experimental-strip-types --loader ./scripts/lib/scoring-diagnostics-ts-loader.mjs scripts/run-top-voice-ingestion.mjs",
    "ingest:autonomous:plan": "node scripts/run-autonomous-ingestion.mjs --plan --idempotency-key=local-plan",
    "artifacts:manifest": "node scripts/write-artifact-manifest.mjs",
    "ingest:s26:company": "node scripts/fetch-public-traction.mjs --social=company",
    "ingest:resume": "node scripts/fetch-public-traction.mjs --social=company",
    "ingest:company": "node scripts/fetch-public-traction.mjs --social=all",
    "ingest:platform": "node scripts/fetch-public-traction.mjs --social=all",
    "ingest:logged-social": "node scripts/fetch-logged-in-social-traction.mjs",
    "ingest:instagram:all": "node scripts/fetch-logged-in-social-traction.mjs --platforms=instagram --entities=all",
    "ingest:instagram:company": "node scripts/fetch-logged-in-social-traction.mjs --platforms=instagram --entities=all --workers=1",
    "instagram:doctor": "node scripts/instagram-doctor.mjs",
    "instagram:discover": "node scripts/discover-instagram-overrides.mjs",
    "instagram:discover:search": "node scripts/discover-instagram-overrides.mjs --search",
    "instagram:discover:web": "node scripts/discover-instagram-overrides.mjs --web-search",
    "instagram:discover:public": "node scripts/discover-instagram-overrides.mjs --web-search --write --append --promote-search --company-only --skip-official",
    "instagram:discover:prune": "node scripts/discover-instagram-overrides.mjs --write --append --prune-web-overrides --max-companies=0 --skip-official",
    "instagram:prune:mismatches": "node scripts/prune-instagram-identity-mismatches.mjs --write --quarantine-search-derived --keep-search-derived=heyclicky",
    "debug:evidence:instagram": "node scripts/debug-evidence-report.mjs --platform=instagram",
    "scoring:experiments": "node scripts/run-scoring-experiments.mjs",
    "scoring:compare": "node scripts/run-scoring-experiments.mjs",
    "scoring:audit:v4": "node --experimental-strip-types --loader ./scripts/lib/scoring-diagnostics-ts-loader.mjs ./scripts/run-scoring-diagnostics-v4.mjs",
    "scoring:research:validate": "vitest run tests/scoring-research-registry.test.ts tests/scoring-v5-provenance.test.ts",
    "scoring:v5:pipeline": "node --experimental-strip-types --loader ./scripts/scoring-v5/typescript-loader.mjs ./scripts/scoring-v5/run.mjs",
    "scoring:v5:validate": "node --experimental-strip-types --loader ./scripts/scoring-v5/typescript-loader.mjs ./scripts/scoring-v5/run.mjs --validate-only",
    "scoring:v5:reproduce": "node --experimental-strip-types --loader ./scripts/scoring-v5/typescript-loader.mjs ./scripts/scoring-v5/run.mjs",
    "scoring:v5:parity": "vitest run tests/scoring-v5-pipeline.test.ts",
    "scoring:v5:audit": "node --test tests/scoring-v5-code-snapshot.node-test.mjs tests/scoring-v5-runner.node-test.mjs && vitest run tests/scoring-research-registry.test.ts tests/scoring-v5-provenance.test.ts tests/scoring-v5-pipeline.test.ts tests/scoring-v5-splits.test.ts",
    "discovery:plan": "node scripts/plan-discovery-tasks.mjs",
    "longrun:checkpoint": "node scripts/long-run-checkpoint.mjs",
    "longrun:run": "node scripts/run-long-cycle.mjs",
    "longrun:run:5h": "node scripts/run-long-cycle.mjs --minutes=300 --checkpoint-minutes=5",
    "longrun:run:6h": "node scripts/run-long-cycle.mjs --minutes=360 --checkpoint-minutes=5",
    "longrun:instagram-thumbnails:6h": "node scripts/run-instagram-thumbnail-remediation.mjs --minutes=360 --checkpoint-minutes=30",
    "longrun:instagram-thumbnails:smoke": "node scripts/run-instagram-thumbnail-remediation.mjs --once --minutes=5 --checkpoint-minutes=1 --discovery-shard-size=2 --thumbnail-limit=1 --x-thumbnail-limit=1 --link-preview-limit=2",
    "longrun:smoke": "node scripts/run-long-cycle.mjs --smoke --minutes=2 --checkpoint-minutes=1",
    "longrun:start": "node scripts/start-long-cycle.mjs",
    "longrun:status": "node scripts/long-run-status.mjs",
    "longrun:report": "node scripts/generate-long-run-report.mjs",
    "longrun:final-verify": "node scripts/run-final-verification.mjs",
    "attribution:loop": "node scripts/run-attribution-feedback-loop.mjs",
    "attribution:loop:5h": "node scripts/run-attribution-feedback-loop.mjs --minutes=300 --checkpoint-minutes=30"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.1.2",
    "cytoscape": "^3.34.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cytoscape": "^3.21.10",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}

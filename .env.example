# App
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SITE_URL=https://www.returner.fund
GOOGLE_SITE_VERIFICATION=

# Site-wide password gate. Set both values in the deployment environment to
# protect every app page, API route, and published data artifact. Never reuse
# an admin or provider credential here.
SITE_PASSWORD=
SITE_ACCESS_SECRET=

# Optional pre-shared key for GET /api/v1/companies/:slug/returner-fund.
# When blank, this bounded read-only endpoint is public.
RETURNER_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only ingestion/admin controls
INGESTION_IDEMPOTENCY_KEY=
ADMIN_INGESTION_SECRET=
ADMIN_TIMELINE_SECRET=
# Production audit attribution is deployment-owned; request actor headers are
# accepted only during local development and tests.
ADMIN_TIMELINE_ACTOR_ID=timeline-admin
ADMIN_TIMELINE_ACTOR_EMAIL=
REFRESH_SECRET=
# Keep false on Vercel unless authenticated raw graph diagnostics are required.
ENABLE_FULL_GRAPH_DIAGNOSTICS=false
# Client-side credential for publishing through an already-running full-graph
# diagnostics endpoint. Set it to that server's ADMIN_INGESTION_SECRET or
# REFRESH_SECRET; the publisher never logs it or stores it in artifacts.
GRAPH_DIAGNOSTICS_SECRET=
ADMIN_INGESTION_FILESYSTEM_FALLBACK=true
ADMIN_INGESTION_ALLOW_INSECURE_LOOPBACK=false

# Optional artifact/object-storage publication. Database manifests are always
# written when autonomous ingestion is enabled.
INGESTION_ARTIFACT_BUCKET=ingestion-artifacts
ARTIFACT_INGESTION_RUN_ID=

# Optional local tooling
AGENT_REACH_CONFIG_PATH=
BROWSER_PROFILE_PATH=
OPENCLI_BIN=
OPENCLI_MAIN=

# Optional official API credentials
GITHUB_TOKEN=
X_BEARER_TOKEN=
EXA_API_KEY=
# Optional Company Timeline web-discovery fallbacks. Search results are
# discovery-only until the linked page is fetched and passes evidence gates.
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
# Optional strict-JSON Company Timeline classification. Both key and model are
# required to enable AI; deterministic classification remains the fallback.
TIMELINE_AI_API_KEY=
TIMELINE_AI_MODEL=
TIMELINE_AI_BASE_URL=https://api.openai.com/v1/
TIMELINE_AI_TIMEOUT_MS=8000
TIMELINE_AI_MAX_ATTEMPTS=2

# Collector policy tuning. Defaults are bounded and platform-specific.
INGESTION_GLOBAL_CONCURRENCY=24
INGESTION_REQUEST_TIMEOUT_MS=20000
INGESTION_MAX_ATTEMPTS=3

# Optional platform cookies. Do not commit real values.
YOUTUBE_COOKIES_PATH=
PLATFORM_COOKIES_PATH=

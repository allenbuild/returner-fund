# App
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SITE_URL=https://returner.fund

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only ingestion/admin controls
INGESTION_IDEMPOTENCY_KEY=
ADMIN_INGESTION_SECRET=
REFRESH_SECRET=
ADMIN_INGESTION_FILESYSTEM_FALLBACK=true
ADMIN_INGESTION_ALLOW_INSECURE_LOOPBACK=false

# Optional artifact/object-storage publication. Database manifests are always
# written when autonomous ingestion is enabled.
INGESTION_ARTIFACT_BUCKET=ingestion-artifacts
ARTIFACT_INGESTION_RUN_ID=

# Optional local tooling
AGENT_REACH_CONFIG_PATH=
BROWSER_PROFILE_PATH=
OPENCLI_BIN=
OPENCLI_MAIN=

# Optional official API credentials
GITHUB_TOKEN=
X_BEARER_TOKEN=
EXA_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=yc-network-intelligence/0.1 by your_reddit_username

# Collector policy tuning. Defaults are bounded and platform-specific.
INGESTION_GLOBAL_CONCURRENCY=24
INGESTION_REQUEST_TIMEOUT_MS=20000
INGESTION_MAX_ATTEMPTS=3

# Optional platform cookies. Do not commit real values.
YOUTUBE_COOKIES_PATH=
PLATFORM_COOKIES_PATH=
